# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
target/

# UI 测试期间截的图，不进版本库
.shots/

# 完整版安装包的 ffmpeg，构建前现下，不入库
src-tauri/resources/components/ffmpeg/*
!src-tauri/resources/components/ffmpeg/README.md

# 生图引擎的 CUDA 12 运行库，构建前从本机 CUDA 现拷，不入库
src-tauri/resources/cuda/*.dll

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 本地临时测试产物（PPTX 预览 fixture 等），可随时删除
.tmp-pptx/

# 临时脚本与截图（可随时删除）
.tmp-journey/
.tmp-test/

# 本地工作流工具的临时目录
.workbuddy/

# 本地模型探针是开发工具（硬编码本机路径），不进版本库
src-tauri/src/bin/

# 打包用 worker 可执行文件（构建产物，由 scripts/prepare-worker.mjs 生成）
src-tauri/resources/worker/
src-tauri/h3d-worker/target/
